# Backend Environment Variables - COPY THIS TO .env AND FILL IN YOUR VALUES
# NEVER commit .env to git

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Local development:
DB_URL=jdbc:mysql://localhost:3306/saanssaathi_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Production (Railway):
# DB_URL=jdbc:mysql://containers-us-west-X.railway.app:PORT/railway?useSSL=true&requireSSL=true&serverTimezone=UTC

DB_USERNAME=saanssaathi_user
DB_PASSWORD=your_secure_database_password_here

# =====================================================
# JWT SECURITY
# =====================================================
# Generate with: openssl rand -base64 64
# Must be at least 256 bits (32 characters minimum)
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_replace_this

# =====================================================
# EXTERNAL API KEYS
# =====================================================
# Get from: https://openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here

# Get from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
# Your frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Spring profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# =====================================================
# EMAIL (Optional - for email notifications)
# =====================================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password_here
# MAIL_FROM=noreply@saanssaathi.in
