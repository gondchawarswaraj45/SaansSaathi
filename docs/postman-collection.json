{
  "info": {
    "_postman_id": "saanssaathi-api-v1",
    "name": "SaansSaathi REST API Collection",
    "description": "Comprehensive Postman collection for the SaansSaathi Urban Air Quality & Family Health Protection Platform.\n\nIncludes endpoints for Authentication, Real-time AQI Telemetry, Family Health Vulnerability Profiles, Indoor Air Quality & DIY Purifiers, AI Saathi Copilot (Gemini), Diurnal Routine Planner, Interactive Geospatial Map, Push Alerts, Gamified Challenges, and Telemetry Administration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. System Health",
      "item": [
        {
          "name": "Health Probe (Liveness & Readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns status UP and current server UTC timestamp."
          }
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"swaraj.tester@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"fullName\": \"Swaraj Test User\",\n  \"city\": \"Delhi NCR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"swaraj.tester@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Authenticated User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Air Quality Telemetry",
      "item": [
        {
          "name": "Get Current AQI (City / Coords)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/air-quality/current?city=Delhi NCR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "air-quality", "current"],
              "query": [
                { "key": "city", "value": "Delhi NCR" }
              ]
            }
          }
        },
        {
          "name": "Get Monitoring Stations for City",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/air-quality/stations?city=Delhi NCR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "air-quality", "stations"],
              "query": [
                { "key": "city", "value": "Delhi NCR" }
              ]
            }
          }
        },
        {
          "name": "Get 24-hr Historical Readings for Station",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/air-quality/history?stationId=1&days=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "air-quality", "history"],
              "query": [
                { "key": "stationId", "value": "1" },
                { "key": "days", "value": "1" }
              ]
            }
          }
        }
      ]
    },
