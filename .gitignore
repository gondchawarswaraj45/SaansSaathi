# Git ignore for SaansSaathi monorepo

# =====================================================
# SECRETS & ENVIRONMENT
# =====================================================
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env
frontend/.env.production
*.env

# =====================================================
# JAVA / MAVEN (Backend)
# =====================================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.properties
!**/src/main/**
!**/src/test/**
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# =====================================================
# NODE / NPM (Frontend)
# =====================================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================
# IDE & EDITORS
# =====================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
.DS_Store
Thumbs.db

# =====================================================
# TESTING
# =====================================================
backend/target/surefire-reports/
backend/target/jacoco.exec

# =====================================================
# LOGS
# =====================================================
*.log
logs/
backend/logs/

# =====================================================
# SQLITE & LOCAL DATABASES
# =====================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =====================================================
# DOCKER (local volumes)
# =====================================================
mysql_data/

# =====================================================
# OS
# =====================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
